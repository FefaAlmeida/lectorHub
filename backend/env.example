# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_banco
DB_PASSWORD=senha_banco
DB_NAME=nome_banco

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações JWT
JWT_SECRET=320c2a4afff5ab80f94f1264f3e643a15d6d391affa6cde663a458c515f76e2d6e171700fa0c8916bdc1a0ee376627ac8b239faed6b5b7e533b1565ba789d60c
JWT_EXPIRES_IN=1h

# Origem do frontend (necessário p/ CORS com credentials/cookie)
FRONTEND_ORIGIN=http://localhost:3000

# SameSite do cookie de sessão. Em dev (tudo em localhost) 'lax' basta.
# Se frontend e API forem publicados em domínios diferentes, use 'none'
# (o cookie passa a ser Secure automaticamente e exige HTTPS).
COOKIE_SAME_SITE=lax

# Usuário administrador — criado/atualizado com `npm run seed:admin`
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@lectorhub.com
ADMIN_PASSWORD=troque-esta-senha

# Configurações de E-mail (SMTP / Nodemailer)
# EMAIL_ENABLED=true liga o envio real. Com qualquer outro valor (ou ausente),
# o e-mail NÃO é enviado — o conteúdo é apenas impresso no console do servidor.
EMAIL_ENABLED=false

# Só são lidas quando EMAIL_ENABLED=true
# Ex. Gmail: host=smtp.gmail.com, port=465, pass = "Senha de app" (exige 2FA na conta)
# Ex. Mailtrap (teste): host=sandbox.smtp.mailtrap.io, port=2525
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app
EMAIL_FROM=Luminar <seu-email@gmail.com>

# Configurações de Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# Configurações de Paginação
PAGINACAO_LIMITE_PADRAO=10
PAGINACAO_LIMITE_MAXIMO=100

